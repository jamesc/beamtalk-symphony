/// SymphonySupervisor — OTP supervision tree for the Symphony service.
/// Loads WORKFLOW.md config at startup, creates clients, and starts
/// Orchestrator, WorkflowWatcher, and optionally HttpServer.
typed Supervisor subclass: SymphonySupervisor

  class start -> Result(Self, Error) => self supervise

  strategy -> Symbol => #oneForOne

  /// Builds the child spec list: loads .env, parses WORKFLOW.md, creates clients.
  /// This is the only method that reads .env and WORKFLOW.md. The runtime sends
  /// each setting separately (ADR 0135), so do not read the files again in
  /// `strategy` or `initialize`.
  ///
  /// A missing or unparseable WORKFLOW.md, or a config that fails validation,
  /// raises an Error naming the cause, so `supervise` fails with
  /// `#supervisor_start_failed` carrying that message. Returning no children
  /// instead would make `initialize` fail on `which:` and hide the cause.
  childSpecs -> List(SupervisionSpec) =>
    DotEnv load: File cwd ++ "/.env"

    wf := (WorkflowLoader load: "./WORKFLOW.md") valueOrDo: [:e |
      Error signal: "WORKFLOW.md: " ++ e displayString
    ]
    config := (Config resolve: (wf at: "config"))
      valueOrDo: [:e |
        Error signal: "WORKFLOW.md config invalid: " ++ (e at: "check") ++ " " ++ (e at: "reason")
      ]

    promptTemplate := wf at: "prompt_template"

    orchestratorSpec := Orchestrator supervisionSpec withClassMethod: #create:promptTemplate:
    orchestratorSpec := orchestratorSpec withArgs: #(config, promptTemplate)
    orchestratorSpec := orchestratorSpec withRestart: #permanent
    watcherSpec := (WorkflowWatcher supervisionSpec withRestart: #permanent) withArgs: #{
      #path => "./WORKFLOW.md"
    }

    specs := #(orchestratorSpec, watcherSpec)

    port := config serverPort
    port isNil ifTrue: [^specs]

    httpSpec := (HttpServer supervisionSpec withRestart: #permanent) withArgs: #{
      #port => port
    }
    specs add: httpSpec

  /// Wires the watcher's reload callback to the orchestrator after both start.
  initialize -> Nil =>
    orch :: Orchestrator := (self which: Orchestrator) unwrap
    watcher :: WorkflowWatcher := (self which: WorkflowWatcher) unwrap
    watcher onReload: [:config :prompt |
      orch reloadConfig: config prompt: prompt
    ]
    nil
