/// RetryPlan — the outcome of a RetryPolicy decision: how many attempts in,
/// how long to wait, and the error (if any) that triggered the retry.
typed Value subclass: RetryPlan
  field: attempt :: Integer
  field: delayMs :: Integer
  field: error :: String | Nil = nil
