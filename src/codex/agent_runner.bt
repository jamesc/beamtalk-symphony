/// AgentRunner — full worker lifecycle for a single issue attempt.
/// Manages workspace creation, prompt rendering, agent backend session
/// (Codex or Claude, selected by config), multi-turn loop, hook
/// execution, and event forwarding.
///
/// Uses helper methods for prompt building, turn management, and cleanup.
typed Actor subclass: AgentRunner
  state: issue :: Issue
  state: attempt :: Integer
  state: config :: ResolvedConfig
  state: workspaceManager :: WorkspaceManager
  state: linearClient :: LinearClient
  state: promptTemplate :: String
  state: onEvent :: Block(Dictionary, Object)
  late state: backend :: CodexClient | ClaudeBackend
  late state: threadId :: String
  state: turnNumber :: Integer

  /// Spawns a new AgentRunner and starts the run lifecycle asynchronously.
  class run: issue :: Issue attempt: attempt :: Integer config: config :: ResolvedConfig workspaceManager: wm :: WorkspaceManager linearClient: lc :: LinearClient promptTemplate: pt :: String onEvent: callback :: Block -> AgentRunner =>
    runner := self
      spawnWith: #{
        #issue => issue,
        #attempt => attempt,
        #config => config,
        #workspaceManager => wm,
        #linearClient => lc,
        #promptTemplate => pt,
        #onEvent => callback,
        #turnNumber => 0
      }
    runner begin!
    runner

  /// Builds the configured backend without launching a session (pure
  /// constructor selection; the backend's process starts on startSession).
  class backendFor: config :: ResolvedConfig workspacePath: wsPath :: String onEvent: callback :: Block(Dictionary, Object) | Nil -> CodexClient | ClaudeBackend =>
    (config agentBackend) =:= "claude"
      ifTrue: [
        ^ClaudeBackend
          start: wsPath
          config: #{
            "command" => config claudeCommand,
            "permissionMode" => config claudePermissionMode,
            "allowedTools" => config claudeAllowedTools,
            "disallowedTools" => config claudeDisallowedTools,
            "readTimeoutMs" => config claudeReadTimeoutMs
          }
          onEvent: callback
      ]
      ifFalse: [
        ^CodexClient
          start: wsPath
          config: #{
            "command" => config codexCommand,
            "readTimeoutMs" => config codexReadTimeoutMs
          }
          onEvent: callback
      ]

  // --- Main lifecycle ---
  terminate: _reason :: Object -> Nil =>
    (self hasField: #backend) ifTrue: [self.backend stopProcess]
    nil

  /// Starts the backend session with an actor-call timeout above the
  /// backend's read timeout. A cold `claude` start (plugin/hook load,
  /// ~3.5s measured) can exceed the default 5s gen_server call
  /// timeout; without the proxy the call raises and skips cleanup.
  startBackendSession -> Result(Dictionary, Error) =>
    timeoutMs := (self.config agentBackend) =:= "claude" ifTrue: [
      self.config claudeReadTimeoutMs + 5000
    ] ifFalse: [self.config codexReadTimeoutMs + 5000]
    proxy := self.backend withTimeout: timeoutMs
    result := [proxy startSession] on: Error do: [:e | Result error: e]
    proxy stop
    result

  begin -> AgentRunner =>
    identifier := self.issue identifier ifNil: [""]
    Logger info: "agent run starting" metadata: #{"issue" => identifier}
    result := self doRun
    result isError
      ifTrue: [
        Logger error: "agent run failed" metadata: #{
          "issue_identifier" => identifier,
          "error" => result error displayString
        }
      ]
      ifFalse: [
        Logger info: "agent run completed" metadata: #{
          "issue_identifier" => identifier,
          "result" => result displayString
        }
      ]
    self

  doRun -> Result(Dictionary, Error) =>
    identifier := self.issue identifier ifNil: [""]
    // Step 1: Create/reuse workspace
    wsResult := self.workspaceManager createForIssue: identifier
    wsResult isError ifTrue: [^wsResult]

    wsPath := wsResult unwrap at: "path"

    // Step 2: Run before_run hook
    hookResult := self.workspaceManager runBeforeRun: wsPath
    hookResult isError ifTrue: [^hookResult]

    // Step 3: Start backend session (Codex or Claude per config)
    self.backend := AgentRunner
      backendFor: self.config
      workspacePath: wsPath
      onEvent: self.onEvent
    sessionResult := self startBackendSession
    sessionResult isError
      ifTrue: [
        self.workspaceManager runAfterRun: wsPath
        self.backend stopProcess
        ^sessionResult
      ]

    sessionData := sessionResult unwrap
    self.threadId := sessionData at: "threadId"

    // Step 4: Multi-turn loop
    self.turnNumber := 1
    maxTurns := self.config maxTurns
    turnLoopResult := self runTurnLoop: wsPath maxTurns: maxTurns

    // Step 5: Cleanup
    self.backend stopProcess
    self.workspaceManager runAfterRun: wsPath

    turnLoopResult

  // --- Prompt helpers ---

  /// Builds the prompt text for the current turn.
  buildPrompt -> Result(String, TemplateError) =>
    self.turnNumber == 1 ifTrue: [
      self buildFirstTurnPrompt
    ] ifFalse: [Result ok: self buildContinuationPrompt]

  /// Renders the prompt template for the first turn.
  buildFirstTurnPrompt -> Result(String, TemplateError) =>
    pr := PromptRenderer
      render: self.promptTemplate
      issue: self.issue
      attempt: self.attempt
    pr

  /// Returns a continuation prompt for subsequent turns.
  buildContinuationPrompt -> String =>
    "Continue working on this issue. This is turn "
      ++ self.turnNumber displayString
      ++ "."

  // --- Turn continuation check ---

  /// Returns a Result if the loop should stop, or nil to continue.
  shouldContinue: maxTurns :: Integer -> Result(Dictionary, Error) | Nil =>
    // Check if max turns reached
    self.turnNumber >= maxTurns ifTrue: [
      ^Result ok: #{"status" => "max_turns_reached"}
    ]

    // Re-check issue state via tracker
    refreshResult := self.linearClient fetchIssueStatesByIds: #(self.issue id)
    refreshResult isError ifTrue: [^refreshResult]

    refreshed := refreshResult unwrap
    refreshed isEmpty ifTrue: [^Result ok: #{"status" => "issue_not_found"}]
    currentState := (refreshed at: 1) state
    activeStates := self.config trackerActiveStates
    isActive := activeStates anySatisfy: [:s |
      s lowercase == currentState lowercase
    ]
    isActive ifFalse: [
      ^Result ok: #{
        "status" => "issue_no_longer_active",
        "state" => currentState
      }
    ]

    nil

  // --- Stream loop (runs in AgentRunner's process) ---

  /// Loops calling backend streamStep until turn completes or times out.
  /// Each streamStep call is short (~1s), avoiding gen_server timeout.
  streamUntilDone: turnTimeoutMs :: Integer -> Result(Dictionary, Error) =>
    deadline := (DateTime now asTimestamp * 1000) + turnTimeoutMs
    self streamLoop: deadline

  streamLoop: deadline :: Integer -> Result(Dictionary, Error) =>
    remaining := deadline - (DateTime now asTimestamp * 1000)
    remaining <= 0
      ifTrue: [
        Logger warn: "backend turn timed out"
        ^Result error: self.backend turnTimeout
      ]
    stepResult := self.backend streamStep
    // nil means no terminal event yet — keep going
    stepResult isNil ifTrue: [^self streamLoop: deadline]
    // Got a Result (ok or error) — return it
    stepResult

  // --- Turn loop ---

  /// Executes the prompt-send-stream cycle for the current turn, then recurses.
  runTurnLoop: wsPath :: String maxTurns: maxTurns :: Integer -> Result(Dictionary, Error) =>
    // Build prompt for this turn
    promptResult := self buildPrompt
    promptResult isError ifTrue: [^promptResult]
    promptText := promptResult unwrap

    // Start the turn
    issueIdentifier := self.issue identifier ifNil: [""]
    issueTitle := self.issue title ifNil: [""]
    title := issueIdentifier ++ ": " ++ issueTitle

    turnResult := self.backend
      startTurn: self.threadId
      prompt: promptText
      title: title
    turnResult isError ifTrue: [^turnResult]

    // Stream events until turn completes (step-by-step to avoid gen_server timeout)
    turnTimeoutMs := (self.config agentBackend) =:= "claude" ifTrue: [
      self.config claudeTurnTimeoutMs
    ] ifFalse: [self.config codexTurnTimeoutMs]
    streamResult := self streamUntilDone: turnTimeoutMs
    streamResult isError ifTrue: [^streamResult]

    // Check whether to continue
    stopResult := self shouldContinue: maxTurns
    stopResult isNil ifFalse: [^stopResult]

    // Continue with next turn
    self.turnNumber := self.turnNumber + 1
    self runTurnLoop: wsPath maxTurns: maxTurns
