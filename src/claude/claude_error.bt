/// ClaudeError — typed error for `claude` CLI subprocess failures.
/// Mirrors CodexError so AgentRunner handles both backends uniformly;
/// both subclass TaggedError (see `tagged_error.bt`).
typed TaggedError subclass: ClaudeError
  field: kind :: String = ""
  field: detail :: Printable | Nil = nil
  field: step :: String | Nil = nil
  field: exitCode :: Integer | Nil = nil
  field: message :: Dictionary | Nil = nil
  field: tool :: String | Nil = nil

  class notFound: detail :: String -> ClaudeError =>
    self new: #{#kind => "not_found", #detail => detail}

  class responseTimeout: detail :: String -> ClaudeError =>
    self new: #{#kind => "response_timeout", #detail => detail}

  class portExit: exitCode :: Integer -> ClaudeError =>
    self new: #{#kind => "port_exit", #exitCode => exitCode}

  class startupFailed: step :: String detail: detail :: TaggedError -> ClaudeError =>
    self new: #{#kind => "startup_failed", #step => step, #detail => detail}

  class turnFailed: msg :: Dictionary -> ClaudeError =>
    self new: #{#kind => "turn_failed", #message => msg}

  class turnCancelled: msg :: Dictionary -> ClaudeError =>
    self new: #{#kind => "turn_cancelled", #message => msg}

  class turnTimeout -> ClaudeError => self new: #{#kind => "turn_timeout"}

  class turnInputRequired: msg :: Dictionary -> ClaudeError =>
    self new: #{#kind => "turn_input_required", #message => msg}

  class permissionDenied: tool :: String -> ClaudeError =>
    self new: #{#kind => "permission_denied", #tool => tool}
