/// TokenUsage — immutable token counters (input/output/total) with delta
/// tracking relative to last reported values.
typed Value subclass: TokenUsage
  uses: JsonMappable
  field: input :: Integer = 0
  field: output :: Integer = 0
  field: total :: Integer = 0
  field: lastReportedInput :: Integer = 0
  field: lastReportedOutput :: Integer = 0
  field: lastReportedTotal :: Integer = 0

  /// Wire-format JSON schema (JsonMappable, BT-2819). Only the current
  /// counters go on the wire, not the delta-tracking baselines.
  class jsonMapping -> JsonMapping =>
    JsonMapping new
      |> mapField: #input to: "input_tokens"
      |> mapField: #output to: "output_tokens"
      |> mapField: #total to: "total_tokens"

  /// Applies absolute token totals from a codex event, replacing current values.
  applyAbsolute: newInput :: Integer output: newOutput :: Integer total: newTotal :: Integer -> TokenUsage =>
    ((self withInput: newInput) withOutput: newOutput) withTotal: newTotal

  /// Snapshots current values as the last-reported baseline for delta computation.
  markReported -> TokenUsage =>
    ((self withLastReportedInput: self input) withLastReportedOutput: self output) withLastReportedTotal: self total

  inputDelta -> Integer => self input - self lastReportedInput

  outputDelta -> Integer => self output - self lastReportedOutput

  totalDelta -> Integer => self total - self lastReportedTotal

  /// Accumulates a per-entry token increase (newTokens minus oldTokens) into
  /// this running global total. Used to roll many per-issue counters up into
  /// one process-wide total without re-summing everything on every event.
  accumulateDelta: newTokens :: TokenUsage from: oldTokens :: TokenUsage -> TokenUsage =>
    self
      applyAbsolute: self input + (newTokens input - oldTokens input)
      output: self output + (newTokens output - oldTokens output)
      total: self total + (newTokens total - oldTokens total)
