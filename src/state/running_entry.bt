/// RunningEntry — immutable value tracking a running agent session.
/// Composes SessionInfo and TokenUsage alongside worker metadata.
typed Value subclass: RunningEntry
  field: workerPid :: Pid | Nil = nil
  field: monitorRef :: Reference | Nil = nil
  field: identifier :: String = ""
  field: issue :: Issue | Nil = nil
  field: session :: SessionInfo = (SessionInfo new: #{#turnCount => 0})
  field: tokens :: TokenUsage = TokenUsage new
  field: retryAttempt :: Integer | Nil = nil
  field: startedAt :: Integer | Nil = nil

  /// Creates a fresh RunningEntry with empty session and token counters.
  class forIssue: issue :: Issue identifier: identifier :: String startedAt: startedAt :: Integer -> RunningEntry =>
    session := SessionInfo new: #{#turnCount => 0}
    RunningEntry
      new: #{
        #identifier => identifier,
        #issue => issue,
        #session => session,
        #tokens => TokenUsage new,
        #startedAt => startedAt
      }

  elapsedMs -> Integer =>
    started := self startedAt
    started isNil ifTrue: [^0]
    now := DateTime now asTimestamp
    (now - started) * 1000

  elapsedSeconds -> Float => self elapsedMs / 1000.0
