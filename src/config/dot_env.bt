/// DotEnv — loads KEY=VALUE pairs from a .env file into the process environment.
typed Object subclass: DotEnv

  /// Reads the .env file at path and sets each KEY=VALUE in the OS environment.
  class load: path :: String -> Result(Integer, Error) =>
    (File readAll: path) ifOk: [:content |
      self parseAndLoad: content
    ] ifError: [:_e | Result ok: 0]

  class parseAndLoad: content :: String -> Result(Integer, Error) =>
    count := 0
    content lines do: [:line |
      (self loadLine: line) ifTrue: [count := count + 1]
    ]
    Result ok: count

  /// Sets the variable on a KEY=VALUE line; answers whether one was set.
  class loadLine: line :: String -> Boolean =>
    trimmed := line trim
    trimmed isEmpty ifTrue: [^false]
    (trimmed startsWith: "#") ifTrue: [^false]
    eqIdx := trimmed indexOf: "="
    eqIdx isNil ifTrue: [^false]
    key := (trimmed take: eqIdx - 1) trim
    val := trimmed drop: eqIdx
    key isEmpty ifTrue: [^false]
    System setEnv: key value: val
    true
