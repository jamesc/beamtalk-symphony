/// PromptRenderer — thin adapter from agent prompt templates to the `liquid`
/// package. Builds the template variables (`issue`, `attempt`), keeps the
/// default prompt for an empty template, and renders with strict variables
/// so a typo in WORKFLOW.md is a dispatch error rather than silent blank text.
/// LiquidError values are mapped to TemplateError.
typed Object subclass: PromptRenderer

  class defaultPrompt -> String => "You are working on an issue from Linear."

  /// Renders a prompt template with issue and attempt variables, returning Result.
  class render: template :: String | Nil issue: issue :: Issue attempt: attempt :: Integer | Nil -> Result(String, TemplateError) =>
    template isNil ifTrue: [^Result ok: self defaultPrompt]
    template trim isEmpty ifTrue: [^Result ok: self defaultPrompt]
    vars := #{"issue" => issue asJson, "attempt" => attempt}
    (Liquid parse: template asString)
      ifOk: [:parsed :: Template |
        (parsed render: vars options: #{
          #strictVariables => true
        }) ifOk: [:text :: String |
          Result ok: text
        ] ifError: [:e :: LiquidError |
          Result error: (TemplateError fromLiquid: e)
        ]
      ]
      ifError: [:e :: LiquidError | Result error: (TemplateError fromLiquid: e)]
