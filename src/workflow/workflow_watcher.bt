/// WorkflowWatcher — polls WORKFLOW.md for modification time changes
/// and triggers a config/prompt reload callback on change.
typed Actor subclass: WorkflowWatcher
  state: path :: String
  state: lastModified :: DateTime | Nil = nil
  state: pollIntervalMs :: Integer = 5000
  state: onReload :: Block(ResolvedConfig, String, Object) | Nil = nil
  state: lastReloadError :: String | Nil = nil

  /// Starts polling the given path for changes, calling callback on reload.
  class start: path :: String onReload: callback :: Block(ResolvedConfig, String, Object) -> WorkflowWatcher =>
    watcher := self spawnWith: #{
      #path => path,
      #onReload => callback,
      #pollIntervalMs => 5000
    }
    watcher schedulePoll!
    watcher

  /// Lifecycle hook — starts the poll loop after supervised spawn.
  initialize -> Nil => self schedulePoll!

  /// Sets the reload callback (used by supervisor initialize: to wire children).
  onReload: callback :: Block(ResolvedConfig, String, Object) -> Block(ResolvedConfig, String, Object) =>
    self.onReload := callback

  schedulePoll -> Timer =>
    Timer after: self.pollIntervalMs do: [self checkForChanges!]

  checkForChanges -> Nil =>
    modTime := self getModTime: self.path
    changed := self.lastModified isNil
      ifTrue: [
        self.lastModified := modTime
        false
      ]
      ifFalse: [modTime /= self.lastModified]

    changed
      ifTrue: [
        self.lastModified := modTime
        self doReload
      ]

    self schedulePoll!

  /// Loads WORKFLOW.md and hands the result to `onReload`. Each failure
  /// (load, validation, or the callback raising, e.g. because the
  /// orchestrator is restarting) is logged and kept in `lastReloadError`
  /// rather than raised: this runs from the `checkForChanges` cast, where an
  /// error would crash the watcher (ADR 0134).
  doReload -> Nil =>
    outcome := (WorkflowLoader load: self.path)
      ifOk: [:wf |
        configResult := Config resolve: (wf at: "config")
        configResult isError
          ifTrue: [
            Logger error: "workflow reload validation failed" metadata: #{
              "path" => self.path,
              "error" => configResult error displayString
            }
            configResult error displayString
          ]
          ifFalse: [
            prompt := wf at: "prompt_template"
            delivered := self.onReload isNil
              ifTrue: [nil]
              ifFalse: [
                [
                  self.onReload value: configResult unwrap value: prompt
                  nil
                ]
                  on: Error
                  do: [:e |
                    Logger error: "workflow reload delivery failed" metadata: #{
                      "path" => self.path,
                      "error" => e message
                    }
                    e message
                  ]
              ]
            delivered isNil ifTrue: [
              Logger info: "workflow reloaded" metadata: #{"path" => self.path}
            ]
            delivered
          ]
      ]
      ifError: [:e |
        Logger error: "workflow reload failed" metadata: #{
          "path" => self.path,
          "error" => e displayString
        }
        e displayString
      ]
    self.lastReloadError := outcome
    nil

  /// Why the last reload failed, or nil if it succeeded (or none ran yet).
  lastReloadError -> String | Nil => self.lastReloadError

  getModTime: filePath :: String -> DateTime | Nil =>
    // Returns modification time or nil
    result := File lastModified: filePath
    result isError ifTrue: [nil] ifFalse: [result unwrap]
