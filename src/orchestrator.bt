/// Orchestrator — central polling authority for the Symphony pipeline.
/// Owns the poll loop, dispatch, reconciliation, retry queue,
/// and global token accounting.
typed Actor subclass: Orchestrator
  state: deps :: OrchestratorDeps
  state: running :: Dictionary(String, RunningEntry) = #{}
  state: claimed :: List(String) = #()
  state: retryAttempts :: Dictionary(String, RetryAttempt) = #{}
  state: completed :: List(String) = #()
  state: codexTotals :: TokenUsage = TokenUsage new
  state: codexRateLimits :: Dictionary | Nil = nil
  state: pollTimerRef :: Timer | Nil = nil

  /// Class method for supervisor bootstrap — creates clients from config.
  /// Used via `withClassMethod: #create:promptTemplate:` so fresh deps
  /// are built on every start/restart.
  class create: config :: ResolvedConfig promptTemplate: pt :: String -> Orchestrator =>
    lc := LinearClient fromConfig: config
    wm := WorkspaceManager fromConfig: config
    deps := OrchestratorDeps
      new: #{
        #config => config,
        #linearClient => lc,
        #workspaceManager => wm,
        #promptTemplate => pt
      }
    self spawnWith: #{#deps => deps}

  /// Lifecycle hook — starts the poll loop.
  initialize -> Nil =>
    Logger info: "orchestrator initialized"
    self startupTerminalCleanup
    self scheduleTick: 0

  /// Lifecycle hook — cancels timers and kills running workers on shutdown.
  terminate: _reason :: Object -> Nil =>
    self.pollTimerRef isNil ifFalse: [self.pollTimerRef cancel]
    self.running do: [:entry |
      entry workerPid isNil ifFalse: [entry workerPid kill]
    ]
    self.retryAttempts do: [:entry |
      entry timerRef isNil ifFalse: [entry timerRef cancel]
    ]

  // --- Config reload ---

  /// Hot-swaps config and prompt template without restarting running agents.
  reloadConfig: newConfig :: ResolvedConfig prompt: newPrompt :: String -> Nil =>
    self.deps := (self.deps withConfig: newConfig) withPromptTemplate: newPrompt
    Logger info: "config reloaded"

  // --- Poll loop ---
  scheduleTick: delayMs :: Integer -> Nil =>
    self.pollTimerRef := Timer after: delayMs do: [self onTick!]
    nil

  /// Main poll tick: reconcile, fetch candidates, filter, dispatch, reschedule.
  onTick -> Nil =>
    // Step 1: Reconcile running issues
    self reconcile

    // Step 2: Fetch candidate issues
    activeStates := self.deps config trackerActiveStates
    fetchResult := self.deps linearClient fetchCandidateIssues: activeStates
    fetchResult isError
      ifTrue: [
        Logger error: "candidate fetch failed" metadata: #{
          "error" => fetchResult error displayString
        }
        self scheduleTick: self.deps config pollIntervalMs
        ^nil
      ]

    // Step 4: Sort and dispatch
    candidates := fetchResult unwrap
    sorted := CandidateFilter sortForDispatch: candidates
    eligible := CandidateFilter
      eligible: sorted
      running: self.running
      claimed: self.claimed
      activeStates: self.deps config trackerActiveStates
      terminalStates: self.deps config trackerTerminalStates
      maxConcurrent: self.deps config maxConcurrentAgents
      maxByState: self.deps config maxConcurrentAgentsByState

    // Step 4b: Dispatch eligible issues
    eligible do: [:issue | self dispatchIssue: issue attempt: 0]

    // Step 5: Publish snapshot to ETS for HTTP server
    self publishSnapshot

    // Step 6: Schedule next tick
    self scheduleTick: self.deps config pollIntervalMs

  // --- Dispatch ---

  /// Spawns an AgentRunner for the issue and tracks it in the running map.
  dispatchIssue: issue :: Issue attempt: attempt :: Integer -> Nil =>
    issueId := issue id
    @expect type
    identifier :: String := issue identifier ifNil: [""]
    Logger info: "dispatching" metadata: #{"issue" => identifier}

    runner := AgentRunner
      run: issue
      attempt: attempt
      config: self.deps config
      workspaceManager: self.deps workspaceManager
      linearClient: self.deps linearClient
      promptTemplate: self.deps promptTemplate
      onEvent: [:event | self onCodexEvent: issueId event: event!]

    runner onExit: [:reason |
      @expect type
      exitReason :: Object := reason
      self onWorkerExit: issueId reason: exitReason!
    ]

    entry := RunningEntry
      forIssue: issue
      identifier: identifier
      startedAt: (DateTime now asTimestamp * 1000)
    entry := entry withWorkerPid: runner

    self.running := self.running at: issueId put: entry
    self.claimed := self.claimed add: issueId
    self.retryAttempts := self.retryAttempts removeKey: issueId

    Logger info: "dispatched" metadata: #{
      "issue_id" => issueId,
      "issue_identifier" => identifier
    }

  // --- Codex event handling ---

  /// Processes a codex stream event, updating session info and token counters.
  onCodexEvent: issueId :: String event: event :: Dictionary -> Nil =>
    entry := self.running at: issueId ifAbsent: [nil]
    entry isNil ifTrue: [^nil]

    // Update session info
    method := event at: "method" ifAbsent: [nil]
    timestamp := event at: "timestamp" ifAbsent: [nil]
    session := entry session
    session := (session withLastEvent: method) withLastTimestamp: timestamp
    // Increment turn count on turn completion
    session := method == "turn/completed" ifTrue: [
      session withTurnCount: session turnCount + 1
    ] ifFalse: [session]
    entry := entry withSession: session

    // Update token usage — call applyUsage: unconditionally to avoid block mutation
    // (applyUsage: handles nil usage internally)
    usage := event at: "usage" ifAbsent: [nil]
    entry := self applyUsage: usage toEntry: entry

    // Update rate limits
    self applyRateLimits: (event at: "rateLimits" ifAbsent: [nil])

    self.running := self.running at: issueId put: entry
    self publishSnapshot

  /// Applies token usage to a running entry and accumulates global totals.
  /// Returns entry unchanged if usage is nil.
  applyUsage: usage :: Dictionary | Nil toEntry: entry :: RunningEntry -> RunningEntry =>
    usage isNil ifTrue: [^entry]
    input := usage at: "input" ifAbsent: [0]
    output := usage at: "output" ifAbsent: [0]
    total := usage at: "total" ifAbsent: [0]
    oldTokens := entry tokens
    newTokens := oldTokens applyAbsolute: input output: output total: total

    self.codexTotals := self.codexTotals accumulateDelta: newTokens from: oldTokens

    entry withTokens: newTokens

  /// Updates rate limits if non-nil.
  applyRateLimits: rateLimits :: Dictionary | Nil -> Dictionary | Nil =>
    rateLimits isNil ifFalse: [self.codexRateLimits := rateLimits]

  // --- Worker exit handling ---

  /// Handles worker process exit — schedules continuation or backoff retry.
  onWorkerExit: issueId :: String reason: reason :: Object -> Nil =>
    entry := self.running at: issueId ifAbsent: [nil]
    entry isNil ifTrue: [^nil]

    // Remove from running
    self.running := self.running removeKey: issueId

    // Add runtime seconds to totals (codexTotals tracks tokens, not seconds)
    Logger
      info: "worker exited"
      metadata: #{
        "issue_id" => issueId,
        "issue_identifier" => entry identifier,
        "reason" => reason displayString
      }

    reason == #normal ifTrue: [self.completed := self.completed add: issueId]

    plan := RetryPolicy
      planForExitReason: reason
      entry: entry
      maxBackoffMs: self.deps config maxRetryBackoffMs
    self
      scheduleRetry: issueId
      identifier: entry identifier
      attempt: plan attempt
      delayMs: plan delayMs
      error: plan error

  // --- Retry queue ---
  scheduleRetry: issueId :: String identifier: identifier :: String attempt: attempt :: Integer delayMs: delayMs :: Integer error: error :: String | Nil -> Nil =>
    // Cancel existing retry timer
    existing := self.retryAttempts at: issueId ifAbsent: [nil]
    existing isNil ifFalse: [
      existing timerRef isNil ifFalse: [existing timerRef cancel]
    ]

    dueAt := (DateTime now asTimestamp * 1000) + delayMs
    timerRef := Timer after: delayMs do: [self onRetryTimer: issueId!]

    entry := RetryAttempt
      new: #{
        #issueId => issueId,
        #identifier => identifier,
        #attempt => attempt,
        #dueAtMs => dueAt,
        #timerRef => timerRef,
        #error => error
      }
    self.retryAttempts := self.retryAttempts at: issueId put: entry

    Logger
      info: "retry scheduled"
      metadata: #{
        "issue_id" => issueId,
        "issue_identifier" => identifier,
        "attempt" => attempt displayString,
        "delay_ms" => delayMs displayString
      }

  onRetryTimer: issueId :: String -> Nil =>
    retryEntry := self.retryAttempts at: issueId ifAbsent: [nil]
    retryEntry isNil ifTrue: [^nil]
    self.retryAttempts := self.retryAttempts removeKey: issueId

    // Fetch active candidates
    fetchResult := self.deps linearClient fetchCandidateIssues: self.deps config trackerActiveStates
    fetchResult isError
      ifTrue: [
        // Re-schedule retry
        plan := RetryPolicy
          planForRescheduleAfter: retryEntry
          maxBackoffMs: self.deps config maxRetryBackoffMs
          error: "retry poll failed"
        self
          scheduleRetry: issueId
          identifier: retryEntry identifier
          attempt: plan attempt
          delayMs: plan delayMs
          error: plan error
        ^nil
      ]

    candidates := fetchResult unwrap
    issue := candidates detect: [:i | i id == issueId] ifNone: [nil]
    issue isNil
      ifTrue: [
        // Issue no longer eligible — release claim
        self.claimed := self.claimed reject: [:id | id == issueId]
        Logger info: "claim released" metadata: #{"issue_id" => issueId}
        ^nil
      ]

    // Check slots
    availableSlots := self.deps config maxConcurrentAgents - self.running size
    availableSlots <= 0
      ifTrue: [
        @expect type
        identifier :: String := issue identifier ifNil: [""]
        plan := RetryPolicy
          planForRescheduleAfter: retryEntry
          maxBackoffMs: self.deps config maxRetryBackoffMs
          error: "no available orchestrator slots"
        self
          scheduleRetry: issueId
          identifier: identifier
          attempt: plan attempt
          delayMs: plan delayMs
          error: plan error
        ^nil
      ]

    // Dispatch
    self dispatchIssue: issue attempt: retryEntry attempt

  // --- Reconciliation ---

  /// Checks for stalled workers and terminal/inactive issue states.
  reconcile -> Nil =>
    self.running isEmpty ifTrue: [^nil]
    self reconcileStalls
    self reconcileStates

  reconcileStalls -> Nil =>
    stallTimeoutMs := self.deps config codexStallTimeoutMs
    stallTimeoutMs <= 0 ifTrue: [^nil]

    nowMs := DateTime now asTimestamp * 1000
    stalledIds := Reconciler
      stalledIssueIds: self.running
      stallTimeoutMs: stallTimeoutMs
      nowMs: nowMs

    stalledIds
      do: [:issueId |
        entry := self.running at: issueId
        Logger warn: "stall detected" metadata: #{
          "issue_id" => issueId,
          "issue_identifier" => entry identifier
        }
        self terminateWorker: issueId cleanup: false
      ]

  reconcileStates -> Nil =>
    runningIds := self.running keys
    runningIds isEmpty ifTrue: [^nil]

    refreshResult := self.deps linearClient fetchIssueStatesByIds: runningIds
    refreshResult isError
      ifTrue: [
        Logger debug: "state refresh failed, keeping workers"
        ^nil
      ]

    refreshed := refreshResult unwrap
    classification := Reconciler
      classify: refreshed
      terminalStates: self.deps config trackerTerminalStates
      activeStates: self.deps config trackerActiveStates

    (classification at: #terminal)
      do: [:issueId |
        entry := self.running at: issueId ifAbsent: [nil]
        entry isNil
          ifFalse: [
            self terminateWorker: issueId cleanup: true
            self.deps workspaceManager removeWorkspace: entry identifier
          ]
      ]

    (classification at: #active)
      do: [:ref |
        entry := self.running at: ref id ifAbsent: [nil]
        entry isNil
          ifFalse: [
            updatedIssue := entry issue withState: ref state
            self.running := self.running at: ref id put: (entry withIssue: updatedIssue)
          ]
      ]

    (classification at: #dropped)
      do: [:issueId | self terminateWorker: issueId cleanup: false]

  terminateWorker: issueId :: String cleanup: cleanup :: Boolean -> Nil =>
    entry := self.running at: issueId ifAbsent: [nil]
    entry isNil ifTrue: [^nil]

    // Kill the worker process
    entry workerPid isNil ifFalse: [entry workerPid kill]

    // Remove from running
    self.running := self.running removeKey: issueId
    self.claimed := self.claimed reject: [:id | id == issueId]

    Logger
      info: "worker terminated"
      metadata: #{
        "issue_id" => issueId,
        "issue_identifier" => entry identifier,
        "cleanup" => cleanup displayString
      }

  // --- Startup terminal cleanup ---

  /// Removes workspaces for issues already in terminal states at boot.
  startupTerminalCleanup -> Nil =>
    terminalStates := self.deps config trackerTerminalStates
    fetchResult := self.deps linearClient fetchIssuesByStates: terminalStates
    fetchResult isError
      ifTrue: [
        Logger warn: "startup terminal cleanup fetch failed"
        ^nil
      ]
    issues := fetchResult unwrap
    issues
      do: [:issue |
        identifier := issue identifier
        identifier isNil ifFalse: [
          self.deps workspaceManager removeWorkspace: identifier
        ]
      ]
    Logger info: "startup cleanup done" metadata: #{
      "removed" => issues size displayString
    }

  // --- Runtime snapshot ---

  /// Returns a serializable snapshot of running agents, retries, and token totals.
  getSnapshot -> Snapshot =>
    Snapshot
      from: self.running
      retrying: self.retryAttempts
      codexTotals: self.codexTotals
      rateLimits: self.codexRateLimits

  /// Publishes the current snapshot to the shared ETS table for HttpServer.
  publishSnapshot -> Nil =>
    table := [Ets named: #symphony_http] on: Error do: [:e | nil]
    table isNil ifFalse: [table at: #snapshot put: self getSnapshot]
