// Tests for CandidateFilter

TestCase subclass: CandidateFilterTest

  testSortByPriority =>
    issues := #(Issue new: #{
      #identifier => "A",
      #priority => 3,
      #createdAt => "2026-01-01"
    }, Issue new: #{
      #identifier => "B",
      #priority => 1,
      #createdAt => "2026-01-01"
    }, Issue new: #{
      #identifier => "C",
      #priority => 2,
      #createdAt => "2026-01-01"
    })
    sorted := CandidateFilter sortForDispatch: issues
    self assert: (sorted at: 1) identifier equals: "B"
    self assert: (sorted at: 2) identifier equals: "C"
    self assert: (sorted at: 3) identifier equals: "A"

  testNilPrioritySortsLast =>
    issues := #(Issue new: #{
      #identifier => "A",
      #priority => nil,
      #createdAt => "2026-01-01"
    }, Issue new: #{
      #identifier => "B",
      #priority => 1,
      #createdAt => "2026-01-01"
    })
    sorted := CandidateFilter sortForDispatch: issues
    self assert: (sorted at: 1) identifier equals: "B"
    self assert: (sorted at: 2) identifier equals: "A"

  testSortByCreatedAtThenIdentifier =>
    issues := #(Issue new: #{
      #identifier => "B",
      #priority => 1,
      #createdAt => "2026-01-02"
    }, Issue new: #{
      #identifier => "A",
      #priority => 1,
      #createdAt => "2026-01-01"
    })
    sorted := CandidateFilter sortForDispatch: issues
    self assert: (sorted at: 1) identifier equals: "A"

  testEligibleIssue =>
    issue := Issue new: #{
      #id => "1",
      #identifier => "X-1",
      #title => "T",
      #state => "Todo"
    }
    result := CandidateFilter
      eligible: #(issue)
      running: #{}
      claimed: #()
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{}
    self assert: result size equals: 1

  testIneligibleIfAlreadyRunning =>
    issue := Issue new: #{
      #id => "1",
      #identifier => "X-1",
      #title => "T",
      #state => "Todo"
    }
    entry := RunningEntry new: #{#issue => issue}
    result := CandidateFilter
      eligible: #(issue)
      running: #{"1" => entry}
      claimed: #()
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{}
    self assert: result size equals: 0

  testIneligibleIfClaimed =>
    issue := Issue new: #{
      #id => "1",
      #identifier => "X-1",
      #title => "T",
      #state => "Todo"
    }
    result := CandidateFilter
      eligible: #(issue)
      running: #{}
      claimed: #("1")
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{}
    self assert: result size equals: 0

  testIneligibleIfNotActiveState =>
    issue := Issue new: #{
      #id => "1",
      #identifier => "X-1",
      #title => "T",
      #state => "Backlog"
    }
    result := CandidateFilter
      eligible: #(issue)
      running: #{}
      claimed: #()
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{}
    self assert: result size equals: 0

  testStateComparisonIsCaseInsensitive =>
    issue := Issue new: #{
      #id => "1",
      #identifier => "X-1",
      #title => "T",
      #state => "todo"
    }
    result := CandidateFilter
      eligible: #(issue)
      running: #{}
      claimed: #()
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{}
    self assert: result size equals: 1

  testGlobalConcurrencyLimit =>
    issue1 := Issue new: #{
      #id => "1",
      #identifier => "X-1",
      #title => "T1",
      #state => "Todo"
    }
    issue2 := Issue new: #{
      #id => "2",
      #identifier => "X-2",
      #title => "T2",
      #state => "Todo"
    }
    entry := RunningEntry new: #{#issue => issue1}
    result := CandidateFilter
      eligible: #(issue2)
      running: #{"1" => entry}
      claimed: #("1")
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 1
      maxByState: #{}
    self assert: result size equals: 0

  testPerStateConcurrencyLimit =>
    issue1 := Issue new: #{
      #id => "1",
      #identifier => "X-1",
      #title => "T1",
      #state => "Todo"
    }
    issue2 := Issue new: #{
      #id => "2",
      #identifier => "X-2",
      #title => "T2",
      #state => "Todo"
    }
    entry := RunningEntry new: #{#issue => issue1}
    result := CandidateFilter
      eligible: #(issue2)
      running: #{"1" => entry}
      claimed: #("1")
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{"todo" => 1}
    self assert: result size equals: 0

  testTodoWithNonTerminalBlockerNotEligible =>
    issue := Issue
      new: #{
        #id => "1",
        #identifier => "X-1",
        #title => "T",
        #state => "Todo",
        #blockedBy => #(IssueRef new: #{
          #id => "2",
          #identifier => "X-2",
          #state => "In Progress"
        })
      }
    result := CandidateFilter
      eligible: #(issue)
      running: #{}
      claimed: #()
      activeStates: #("Todo", "In Progress")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{}
    self assert: result size equals: 0

  testTodoWithTerminalBlockerIsEligible =>
    issue := Issue
      new: #{
        #id => "1",
        #identifier => "X-1",
        #title => "T",
        #state => "Todo",
        #blockedBy => #(IssueRef new: #{
          #id => "2",
          #identifier => "X-2",
          #state => "Done"
        })
      }
    result := CandidateFilter
      eligible: #(issue)
      running: #{}
      claimed: #()
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{}
    self assert: result size equals: 1

  testMissingRequiredFieldsNotEligible =>
    issue := Issue new: #{#id => "1", #identifier => "X-1", #state => "Todo"}
    result := CandidateFilter
      eligible: #(issue)
      running: #{}
      claimed: #()
      activeStates: #("Todo")
      terminalStates: #("Done")
      maxConcurrent: 10
      maxByState: #{}
    self assert: result size equals: 0
