// Tests for PromptRenderer

TestCase subclass: PromptRendererTest

  // Helper to build template strings with braces
  var: name => "\{\{" ++ name ++ "}}"

  ifOpen: name => "\{% if " ++ name ++ " %}"

  ifClose => "\{% endif %}"

  forOpen: expr => "\{% for " ++ expr ++ " %}"

  forClose => "\{% endfor %}"

  testRendersIssueFields =>
    template := "Work on "
      ++ (self var: "issue.identifier")
      ++ ": "
      ++ (self var: "issue.title")
    issue := Issue new: #{
      #identifier => "BT-42",
      #title => "Fix the bug",
      #id => "abc"
    }
    result := PromptRenderer
      render: template
      issue: issue
      attempt: nil
    self assert: (self assertOk: result) equals: "Work on BT-42: Fix the bug"

  testRendersAttemptVariable =>
    template := "Attempt: " ++ (self var: "attempt")
    issue := (Issue new: #{#id => "x"})
    result := PromptRenderer
      render: template
      issue: issue
      attempt: 3
    self assert: (self assertOk: result) equals: "Attempt: 3"

  testNilAttemptRendersEmpty =>
    template := "Attempt: " ++ (self var: "attempt")
    issue := (Issue new: #{#id => "x"})
    result := PromptRenderer
      render: template
      issue: issue
      attempt: nil
    self assert: (self assertOk: result) equals: "Attempt: "

  testEmptyTemplateUsesDefault =>
    result := PromptRenderer
      render: ""
      issue: (Issue new: #{#id => "x"})
      attempt: nil
    self assert: (self assertOk: result) equals: "You are working on an issue from Linear."

  testNilTemplateUsesDefault =>
    result := PromptRenderer
      render: nil
      issue: (Issue new: #{#id => "x"})
      attempt: nil
    self assert: (self assertOk: result) equals: "You are working on an issue from Linear."

  testIfBlockTrue =>
    template := (self ifOpen: "issue.description")
      ++ "Desc: "
      ++ (self var: "issue.description")
      ++ self ifClose
    issue := Issue new: #{#description => "Some description"}
    result := PromptRenderer
      render: template
      issue: issue
      attempt: nil
    self assert: (self assertOk: result) equals: "Desc: Some description"

  testIfBlockFalse =>
    template := "Start"
      ++ (self ifOpen: "issue.description")
      ++ " desc"
      ++ self ifClose
      ++ " end"
    issue := Issue new
    result := PromptRenderer
      render: template
      issue: issue
      attempt: nil
    self assert: (self assertOk: result) equals: "Start end"

  testForLoop =>
    template := "Labels:"
      ++ (self forOpen: "label in issue.labels")
      ++ " "
      ++ (self var: "label")
      ++ self forClose
    issue := Issue new: #{#labels => #("bug", "urgent")}
    result := PromptRenderer
      render: template
      issue: issue
      attempt: nil
    rendered := self assertOk: result
    self assert: (rendered includesSubstring: "bug")
    self assert: (rendered includesSubstring: "urgent")

  testMultipleInterpolations =>
    template := (self var: "issue.identifier")
      ++ ": "
      ++ (self var: "issue.title")
      ++ " ("
      ++ (self var: "attempt")
      ++ ")"
    issue := Issue new: #{#identifier => "X-1", #title => "Do it"}
    result := PromptRenderer
      render: template
      issue: issue
      attempt: 2
    self assert: (self assertOk: result) equals: "X-1: Do it (2)"
