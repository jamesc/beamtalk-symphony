// Tests for AgentRunner — unit tests for prompt rendering.
// Full lifecycle tests require a real codex app-server.

TestCase subclass: AgentRunnerTest

  testFirstTurnPromptRendering =>
    issue := Issue new: #{
      #identifier => "BT-1",
      #title => "Fix bug",
      #id => "abc"
    }
    lb := "\{"
    rb := "}"
    template := lb
      ++ lb
      ++ " issue.identifier "
      ++ rb
      ++ rb
      ++ ": "
      ++ lb
      ++ lb
      ++ " issue.title "
      ++ rb
      ++ rb
    result := PromptRenderer
      render: template
      issue: issue
      attempt: nil
    self assert: (self assertOk: result) equals: "BT-1: Fix bug"

  testContinuationPromptFormat =>
    turnNumber := 3
    prompt := "Continue working on this issue. This is turn "
      ++ turnNumber displayString
      ++ "."
    self assert: (prompt includesSubstring: "turn 3")
    self assert: (prompt includesSubstring: "Continue")

  testFirstTurnPromptWithAttempt =>
    issue := Issue new: #{#identifier => "X-1", #title => "Task", #id => "x"}
    result := PromptRenderer
      render: "Work on it"
      issue: issue
      attempt: 2
    self assert: (self assertOk: result) equals: "Work on it"

  // --- Backend selection (BT-4155) ---
  testBackendDefaultsToCodex =>
    config := ResolvedConfig new: #{}
    backend := AgentRunner
      backendFor: config
      workspacePath: "/tmp"
      onEvent: nil
    self assert: (backend isKindOf: CodexClient)
    self assert: backend stop equals: #ok

  testBackendSelectsClaude =>
    config := ResolvedConfig
      new: #{
        #agentBackend => "claude",
        #claudeCommand => "echo hello",
        #claudePermissionMode => "dontAsk"
      }
    backend := AgentRunner
      backendFor: config
      workspacePath: "/tmp"
      onEvent: nil
    self assert: (backend isKindOf: ClaudeBackend)
    self assert: backend stop equals: #ok
